# Másold .env néven, és cseréld le az összes CHANGE_ME értéket.
# A fájl kizárólag helyi Development használatra szolgál.
POSTGRES_DB=patika_beosztas
POSTGRES_USER=patika_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
POSTGRES_HOST_PORT=55432

# Az API indításakor környezeti változóként add át.
ConnectionStrings__DefaultConnection=Host=localhost;Port=55432;Database=patika_beosztas;Username=patika_app;Password=CHANGE_ME_LOCAL_DATABASE_PASSWORD
Seed__DemoPassword=CHANGE_ME_DEVELOPMENT_DEMO_PASSWORD_12_CHARS

# Pontos HTTPS frontend origin; további origineknél használd a __1, __2 stb. indexet.
Cors__AllowedOrigins__0=https://localhost:5173
