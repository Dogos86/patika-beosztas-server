# Patika Beosztás – frontend környezet
#
# Adatforrás mód:
#   api → valós backend (cookie + CSRF, HTTPS, azonos site)
#
# A közös kiadás API-only; a mock implementáció nincs a production bundle-ben.
# A phase1-http érték továbbra is működik az api szinonimájaként (kompatibilitás).
VITE_DATA_SOURCE=api
VITE_APP_ENV=development
VITE_ENABLE_DEMO_LOGIN=false
VITE_ENABLE_AI=false
VITE_ENABLE_NOTIFICATIONS=false

# Ha megadod, a HTTP kliens ehhez a base URL-hez fűzi a /api/... path-eket.
# Ha üres, a kliens relatív URL-eket használ, és a dev proxy (lásd lent)
# viszi tovább a kéréseket a backendhez. Éles környezetben a frontend és a
# backend azonos site-on fut, tehát üres.
VITE_API_URL=

# Lokális fejlesztés – Vite dev proxy célja (/api, /health, /openapi útvonalak).
# A backend alap URL-je HTTPS-en. A böngésző csak a frontend originhez kapcsolódik.
VITE_API_PROXY_TARGET=https://localhost:7180
